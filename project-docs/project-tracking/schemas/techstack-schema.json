{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://project-tracking-template/schemas/techstack-schema.json",
  "title": "Technology Stack Schema",
  "description": "Schema for validating techstack.yaml - technology choices and standards",
  "type": "object",
  "required": ["language", "dependencies", "quality_standards", "hard_rules"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Path to this schema file"
    },
    "language": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "justification": {"type": "string"}
      }
    },
    "framework": {
      "type": "object",
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"},
        "justification": {"type": "string"}
      }
    },
    "database": {
      "type": "object",
      "properties": {
        "primary": {
          "type": "object",
          "properties": {
            "name": {"type": "string"},
            "version": {"type": "string"},
            "justification": {"type": "string"}
          }
        },
        "orm": {
          "type": "object",
          "properties": {
            "name": {"type": "string"},
            "version": {"type": "string"},
            "justification": {"type": "string"}
          }
        }
      }
    },
    "testing": {
      "type": "object",
      "properties": {
        "unit": {
          "type": "object",
          "properties": {
            "name": {"type": "string"},
            "version": {"type": "string"},
            "plugins": {
              "type": "array",
              "items": {"type": "string"}
            }
          }
        },
        "linting": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {"type": "string"},
              "version": {"type": "string"}
            }
          }
        }
      }
    },
    "dev_tools": {
      "type": "object",
      "properties": {
        "package_manager": {"type": "string"},
        "dependency_management": {"type": "string"},
        "environment": {"type": "string"},
        "pre_commit": {"type": "boolean"}
      }
    },
    "agent_framework": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "name": {"type": "string"},
        "version": {"type": "string"}
      }
    },
    "dependencies": {
      "type": "object",
      "required": ["core"],
      "properties": {
        "core": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1
        },
        "dev": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "api_standards": {
      "type": "object",
      "properties": {
        "format": {"type": "string"},
        "documentation": {"type": "string"},
        "authentication": {"type": "string"},
        "versioning": {"type": "string"}
      }
    },
    "quality_standards": {
      "type": "object",
      "required": ["test_coverage_minimum"],
      "properties": {
        "test_coverage_minimum": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "type_hints": {
          "type": "string",
          "enum": ["required", "recommended", "optional"]
        },
        "docstrings": {
          "type": "string",
          "enum": ["required", "recommended", "optional"]
        },
        "max_line_length": {
          "type": "integer",
          "minimum": 80
        }
      }
    },
    "environments": {
      "type": "object",
      "properties": {
        "local": {
          "type": "object",
          "properties": {
            "description": {"type": "string"},
            "database": {"type": "string"}
          }
        },
        "staging": {
          "type": "object",
          "properties": {
            "description": {"type": "string"},
            "database": {"type": "string"}
          }
        },
        "production": {
          "type": "object",
          "properties": {
            "description": {"type": "string"},
            "database": {"type": "string"}
          }
        }
      }
    },
    "hard_rules": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1,
      "description": "Non-negotiable constraints for sub-agents"
    },
    "version_control": {
      "type": "object",
      "properties": {
        "system": {"type": "string"},
        "branching_strategy": {"type": "string"},
        "commit_message_format": {"type": "string"}
      }
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
