{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://project-tracking-template/schemas/project-schema.json",
  "title": "Project Tracker Config Schema",
  "type": "object",
  "required": [
    "project_name",
    "project_version",
    "overview_path",
    "current_phase",
    "stack",
    "commands"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Relative path to this schema file"
    },
    "project_name": {
      "type": "string",
      "minLength": 1,
      "description": "Name of the project"
    },
    "project_version": {
      "type": "string",
      "minLength": 1,
      "description": "Current project version"
    },
    "summary": {
      "type": "string",
      "description": "Short description of the project"
    },
    "goal": {
      "type": "string",
      "description": "Primary success metric or outcome"
    },
    "overview_path": {
      "type": "string",
      "minLength": 1,
      "description": "Path to the detailed project overview document"
    },
    "current_phase": {
      "type": "string",
      "pattern": "^PHASE_\\d+$",
      "description": "Current phase identifier"
    },
    "stack": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "List of core technologies"
    },
    "commands": {
      "type": "object",
      "description": "Key commands that agents should run",
      "minProperties": 1,
      "additionalProperties": {
        "anyOf": [
          { "type": "string", "minLength": 1 },
          {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        ]
      },
      "properties": {
        "validate": {
          "anyOf": [
            { "type": "string", "minLength": 1 },
            {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          ],
          "description": "Command to validate tracking files"
        },
        "quick_check": {
          "anyOf": [
            { "type": "string", "minLength": 1 },
            {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          ],
          "description": "Command for quick project health summary"
        }
      },
      "required": ["validate"]
    },
    "environments": {
      "type": "string",
      "description": "Notes about environments or deployment targets"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Additional free-form notes"
    }
  },
  "additionalProperties": false
}
