# =============================================================================
# EscapePlan API Environment Variables
# =============================================================================
# Copy this file to .env and customize for your environment
# Most values are auto-detected and don't need to be changed!

# -----------------------------------------------------------------------------
# Runtime Detection (optional - auto-detected)
# -----------------------------------------------------------------------------
# NODE_ENV=production              # Auto-detected: development | production | test
# PORT=4000                         # Auto-detected from environment
# HOST=0.0.0.0                      # Bind address

# -----------------------------------------------------------------------------
# URLs (optional - auto-detected based on NODE_ENV)
# -----------------------------------------------------------------------------
# Development defaults:
#   BASE_URL=http://localhost:4000
#   AUTH_BASE_URL=http://localhost:4000/api/auth
#   WEB_APP_ORIGIN=http://localhost:5173
#
# Production defaults:
#   BASE_URL=https://escapeplan.local
#   AUTH_BASE_URL=https://escapeplan.local/api/auth
#   WEB_APP_ORIGIN=https://escapeplan.local
#
# Override only if needed:
# BASE_URL=https://custom-domain.com
# AUTH_BASE_URL=https://custom-domain.com/api/auth
# WEB_APP_ORIGIN=https://custom-domain.com

# -----------------------------------------------------------------------------
# Release Configuration (optional - auto-detected)
# -----------------------------------------------------------------------------
# GITHUB_REPO=yourorg/escapeplan     # Auto-detected from package.json
# BUILD_DATE=2024-10-01T12:00:00Z    # Auto-set during build
# ENABLE_AUTO_UPDATE=true            # Set to 'false' to disable

# -----------------------------------------------------------------------------
# Asset Storage
# -----------------------------------------------------------------------------
MAX_IMAGE_SIZE_MB=10
MAX_AUDIO_SIZE_MB=25
MAX_VIDEO_SIZE_MB=50

# Storage paths (defaults shown):
# ESCAPEPLAN_DATA_DIR=/var/lib/escapeplan          # Production
# ESCAPEPLAN_DATA_DIR=./data                       # Development
# ESCAPEPLAN_ASSET_DIR=/var/lib/escapeplan/assets  # Production
# ESCAPEPLAN_ASSET_DIR=./data/assets               # Development

# -----------------------------------------------------------------------------
# Backup Configuration
# -----------------------------------------------------------------------------
# ESCAPEPLAN_BACKUP_DIR=/var/backups/escapeplan
BACKUP_RETENTION_DAYS=7

# -----------------------------------------------------------------------------
# Platform Integration (production only)
# -----------------------------------------------------------------------------
# NGINX_PROXY=true                  # Set by systemd when behind nginx
