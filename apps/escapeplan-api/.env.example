# URL the Better Auth server advertises; update to https://escapeplan.local/api/auth on device
AUTH_BASE_URL=http://localhost:4000/api/auth
# Origin allowed to access the API; update to https://escapeplan.local on device
WEB_APP_ORIGIN=http://localhost:5173

# Asset Storage Configuration
# Maximum file sizes in megabytes
MAX_IMAGE_SIZE_MB=10
MAX_AUDIO_SIZE_MB=25
MAX_VIDEO_SIZE_MB=50

# Asset storage paths (production only, dev uses ./data)
# ESCAPEPLAN_DATA_DIR=/var/lib/escapeplan
# ESCAPEPLAN_ASSET_DIR=/var/lib/escapeplan/assets

# Backup Configuration
# ESCAPEPLAN_BACKUP_DIR=/var/backups/escapeplan
BACKUP_RETENTION_DAYS=7
