{
  "name": "escapeplan-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup src/index.ts --format esm --out-dir dist",
    "lint": "tsc --noEmit",
    "test": "vitest",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:fresh": "tsx src/db/seed.ts --clear"
  },
  "dependencies": {
    "@dicebear/bottts": "^9.2.4",
    "@dicebear/core": "^9.2.4",
    "@escapeplan/contracts": "workspace:*",
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.2.1",
    "@fastify/static": "^8.2.0",
    "@types/fluent-ffmpeg": "^2.1.27",
    "argon2": "^0.40.3",
    "better-auth": "^1.3.23",
    "better-sqlite3": "^9.6.0",
    "drizzle-orm": "^0.30.7",
    "fastify": "^5.6.1",
    "fluent-ffmpeg": "^2.1.3",
    "nanoid": "^5.0.7",
    "sharp": "^0.34.4",
    "socket.io": "^4.8.1",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.5",
    "@types/node": "^20.11.30",
    "drizzle-kit": "^0.26.2",
    "tsup": "^8.2.4",
    "tsx": "^4.7.2",
    "typescript": "^5.5.0",
    "vitest": "^1.5.0"
  }
}
