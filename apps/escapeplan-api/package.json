{
  "name": "escapeplan-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup src/index.ts --format esm --dts --out-dir dist",
    "lint": "tsc --noEmit",
    "test": "vitest",
    "db:seed": "node --experimental-strip-types src/db/seed.ts"
  },
  "dependencies": {
    "@escapeplan/contracts": "workspace:*",
    "@fastify/cors": "^10.0.1",
    "drizzle-orm": "^0.30.7",
    "fastify": "^5.6.1",
    "nanoid": "^5.0.7",
    "argon2": "^0.40.3",
    "better-sqlite3": "^9.6.0",
    "socket.io": "^4.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "drizzle-kit": "^0.26.2",
    "@types/better-sqlite3": "^7.6.5",
    "tsup": "^8.2.4",
    "tsx": "^4.7.2",
    "typescript": "^5.5.0",
    "vitest": "^1.5.0"
  }
}
