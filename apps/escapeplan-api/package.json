{
  "name": "escapeplan-api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup src/index.ts --format esm --out-dir dist && tsup src/db/migrate.ts --format esm --no-splitting --out-dir dist/db && tsup src/db/seed.ts --format esm --no-splitting --out-dir dist/db",
    "lint": "tsc --noEmit",
    "test": "vitest",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:verify": "tsx src/db/migrate.ts --verify",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:fresh": "tsx src/db/seed.ts --clear",
    "db:seed:settings": "tsx src/db/seed-settings.ts",
    "backup": "tsx scripts/backup.ts",
    "backup:list": "tsx scripts/list-backups.ts",
    "backup:restore": "tsx scripts/restore.ts"
  },
  "dependencies": {
    "@dicebear/bottts": "^9.2.4",
    "@dicebear/core": "^9.2.4",
    "@escapeplan/contracts": "workspace:*",
    "@fastify/cookie": "^10.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/csrf-protection": "^7.0.1",
    "@fastify/multipart": "^9.2.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.2.0",
    "@types/fluent-ffmpeg": "^2.1.27",
    "argon2": "^0.40.3",
    "better-auth": "^1.3.24",
    "better-sqlite3": "^12.4.1",
    "drizzle-orm": "^0.44.5",
    "fastify": "^5.6.1",
    "fluent-ffmpeg": "^2.1.3",
    "nanoid": "^5.0.7",
    "node-onvif": "^0.1.7",
    "sharp": "^0.34.4",
    "socket.io": "^4.8.1",
    "sodium-native": "^5.0.9",
    "tar": "^7.5.1",
    "ulid": "^3.0.1",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.5",
    "@types/node": "^20.11.30",
    "@types/tar": "^6.1.13",
    "drizzle-kit": "^0.31.5",
    "pino-pretty": "^13.1.1",
    "tsup": "^8.2.4",
    "tsx": "^4.7.2",
    "typescript": "^5.5.0",
    "vitest": "^1.5.0"
  }
}
