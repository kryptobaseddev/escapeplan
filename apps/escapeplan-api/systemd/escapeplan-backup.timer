[Unit]
Description=EscapePlan Daily Backup Timer
Documentation=https://github.com/yourorg/escapeplan
Requires=escapeplan-backup.service

[Timer]
# Run daily at 2:00 AM local time
OnCalendar=daily
OnCalendar=*-*-* 02:00:00

# Run on boot if missed (within 15 minutes)
Persistent=true

# Randomize start time by up to 5 minutes to avoid resource contention
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
