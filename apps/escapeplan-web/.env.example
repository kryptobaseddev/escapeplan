# =============================================================================
# EscapePlan Web Environment Variables
# =============================================================================
# Copy this file to .env and customize for your environment
# API URL is auto-detected - no manual configuration needed!

# -----------------------------------------------------------------------------
# API Base URL (optional - auto-detected)
# -----------------------------------------------------------------------------
# Development: Auto-detects http://localhost:4000/api
# Production:  Auto-detects https://escapeplan.local/api (same-origin)
#
# Override only if using custom domain:
# PUBLIC_API_BASE_URL=https://custom-domain.com/api

# -----------------------------------------------------------------------------
# Build Configuration (optional)
# -----------------------------------------------------------------------------
# Set during build for embedded API URL:
# PUBLIC_API_BASE_URL=https://escapeplan.local/api
