# ============================================================================
# EscapePlan Web - Environment Variables
# ============================================================================
# Copy this file to .env for local development
# Usage: cp .env.example .env
# ============================================================================

# ----------------------------------------------------------------------------
# Public Environment Variables (sent to browser)
# ----------------------------------------------------------------------------
# These are available via import.meta.env.PUBLIC_* at build time
# WARNING: Do NOT put secrets here - they are publicly visible in the browser
# ----------------------------------------------------------------------------

# API base URL for client-side requests
# Development: Leave empty to use Vite proxy (/api → http://localhost:4000)
# Production: Set to /api (nginx proxies to backend)
# This setting is optional - if not set, the app auto-detects the correct URL
# PUBLIC_API_BASE_URL=/api

# WebSocket URL for real-time updates (optional)
# Leave empty to use same origin as the web app
# The app will automatically connect to the correct WebSocket endpoint
# PUBLIC_SOCKET_URL=

# ----------------------------------------------------------------------------
# Development Server Configuration
# ----------------------------------------------------------------------------

# Vite dev server port (default: 5173, configured in vite.config.ts)
# PORT=5173

# ----------------------------------------------------------------------------
# Production Configuration
# ----------------------------------------------------------------------------
# In production, systemd loads environment variables from /etc/escapeplan/web.env
# The systemd service sets PUBLIC_API_BASE_URL=/api
# nginx proxies both escapeplan.local and 10.10.10.1 to the backend

# ----------------------------------------------------------------------------
# Notes
# ----------------------------------------------------------------------------
# - In development, Vite proxies /api to http://localhost:4000 (see vite.config.ts)
# - In production, nginx proxies /api to the backend API service
# - The app works with any hostname: escapeplan.local, 10.10.10.1, etc.
# - PUBLIC_* variables are embedded in the client bundle at build time
# - Non-PUBLIC variables are server-side only
# - Socket.IO automatically uses the same origin as the web app
