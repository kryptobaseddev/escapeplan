#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE' >&2
Usage: escapeplan-config-apply --config <config.json>

Configuration schema (all values required unless noted):
{
  "wifi": {
    "ssid": "EscapePlan",
    "passphrase": "strongpassphrase",
    "channel": 6,
    "band": "5g",           // optional: "2g", "5g", or "auto"
    "country": "US"          // optional ISO 3166-1 alpha-2
  },
  "network": {
    "router": "10.10.10.1",
    "dns": "10.10.10.1",
    "dhcpRangeStart": "10.10.10.100",
    "dhcpRangeEnd": "10.10.10.199",
    "domain": "escapeplan.local"
  },
  "nginx": {
    "serverName": "escapeplan.local",
    "apiUpstream": "http://127.0.0.1:4000",
    "webRoot": "/opt/escapeplan/web/build/client",
    "webUpstream": "http://127.0.0.1:4173"
  },
  "env": {
    "api": { "NODE_ENV": "production" },
    "web": { "PUBLIC_API_URL": "https://escapeplan.local/api" }
  },
  "services": {
    "enableApi": true,
    "enableWeb": true,
    "enableWifi": true
  }
}
USAGE
}

CONFIG_PATH=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --config)
      CONFIG_PATH="$2"
      shift 2
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage
      exit 1
      ;;
  esac
done

if [[ -z "$CONFIG_PATH" ]]; then
  echo "--config is required." >&2
  usage
  exit 1
fi

if [[ ! -f "$CONFIG_PATH" ]]; then
  echo "Config file not found: $CONFIG_PATH" >&2
  exit 1
fi

if ! command -v jq >/dev/null 2>&1; then
  echo "jq is required to parse configuration." >&2
  exit 1
fi

jq -e '.' "$CONFIG_PATH" >/dev/null

wifi_ssid=$(jq -r '.wifi.ssid // empty' "$CONFIG_PATH")
wifi_psk=$(jq -r '.wifi.passphrase // empty' "$CONFIG_PATH")
wifi_channel=$(jq -r '.wifi.channel // empty' "$CONFIG_PATH")
wifi_band=$(jq -r '.wifi.band // "auto"' "$CONFIG_PATH")
wifi_country=$(jq -r '.wifi.country // "US"' "$CONFIG_PATH")

if [[ -z "$wifi_ssid" || -z "$wifi_psk" || -z "$wifi_channel" ]]; then
  echo "wifi.ssid, wifi.passphrase, and wifi.channel are required." >&2
  exit 1
fi

if [[ ${#wifi_psk} -lt 8 || ${#wifi_psk} -gt 63 ]]; then
  echo "wifi.passphrase must be between 8 and 63 characters." >&2
  exit 1
fi

case "$wifi_band" in
  2g|2G|bg|g)
    wifi_hw_mode="g"
    ;;
  5g|5G|a)
    wifi_hw_mode="a"
    ;;
  auto|AUTO|Auto)
    wifi_hw_mode="a"
    ;;
  *)
    echo "Unknown wifi.band value: $wifi_band" >&2
    exit 1
    ;;
esac

network_router=$(jq -r '.network.router // "10.10.10.1"' "$CONFIG_PATH")
network_dns=$(jq -r '.network.dns // "10.10.10.1"' "$CONFIG_PATH")
dhcp_start=$(jq -r '.network.dhcpRangeStart // "10.10.10.100"' "$CONFIG_PATH")
dhcp_end=$(jq -r '.network.dhcpRangeEnd // "10.10.10.199"' "$CONFIG_PATH")
network_domain=$(jq -r '.network.domain // "escapeplan.local"' "$CONFIG_PATH")

server_name=$(jq -r '.nginx.serverName // "escapeplan.local"' "$CONFIG_PATH")
api_upstream=$(jq -r '.nginx.apiUpstream // "http://127.0.0.1:4000"' "$CONFIG_PATH")
web_root=$(jq -r '.nginx.webRoot // "/opt/escapeplan/web/build/client"' "$CONFIG_PATH")
web_upstream=$(jq -r '.nginx.webUpstream // "http://127.0.0.1:4173"' "$CONFIG_PATH")

services_enable_api=$(jq -r '.services.enableApi // false' "$CONFIG_PATH")
services_enable_web=$(jq -r '.services.enableWeb // false' "$CONFIG_PATH")
services_enable_wifi=$(jq -r '.services.enableWifi // false' "$CONFIG_PATH")

ESCAPEPLAN_ETC=/etc/escapeplan

cat <<HOSTAPD >"${ESCAPEPLAN_ETC}/hostapd.conf"
interface=wlan0
ssid=${wifi_ssid}
channel=${wifi_channel}
country_code=${wifi_country}
hw_mode=${wifi_hw_mode}
tx_queue_len=2000
wpa=2
wpa_key_mgmt=WPA-PSK
rsn_pairwise=CCMP
wpa_passphrase=${wifi_psk}
ieee80211n=1
ieee80211ac=1
require_ht=1
HOSTAPD

chmod 0640 "${ESCAPEPLAN_ETC}/hostapd.conf"
chown root:escapeplan "${ESCAPEPLAN_ETC}/hostapd.conf"

cat <<DNSMASQ >"${ESCAPEPLAN_ETC}/dnsmasq.conf"
interface=wlan0
bind-interfaces
dhcp-range=${dhcp_start},${dhcp_end},12h
dhcp-option=option:router,${network_router}
dhcp-option=option:dns-server,${network_dns}
domain=${network_domain}
address=/${network_domain}/${network_router}
DNSMASQ

chmod 0640 "${ESCAPEPLAN_ETC}/dnsmasq.conf"
chown root:escapeplan "${ESCAPEPLAN_ETC}/dnsmasq.conf"

cat <<NGINX >/etc/escapeplan/nginx.conf
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name ${server_name};

    root ${web_root};
    try_files \$uri \$uri/ @escapeplan_web;

    location /api/ {
        proxy_pass ${api_upstream}/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
    }

    location /ws/ {
        proxy_pass ${api_upstream}/ws/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
    }

    location @escapeplan_web {
        proxy_pass ${web_upstream};
        proxy_http_version 1.1;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
    }
}
NGINX

chmod 0640 /etc/escapeplan/nginx.conf
chown root:escapeplan /etc/escapeplan/nginx.conf

if jq -e '.env.api | type == "object"' "$CONFIG_PATH" >/dev/null; then
  jq -r '.env.api | to_entries[] | "\(.key)=\(.value)"' "$CONFIG_PATH" >"${ESCAPEPLAN_ETC}/api.env"
  chmod 0640 "${ESCAPEPLAN_ETC}/api.env"
  chown root:escapeplan "${ESCAPEPLAN_ETC}/api.env"
fi

if jq -e '.env.web | type == "object"' "$CONFIG_PATH" >/dev/null; then
  jq -r '.env.web | to_entries[] | "\(.key)=\(.value)"' "$CONFIG_PATH" >"${ESCAPEPLAN_ETC}/web.env"
  chmod 0640 "${ESCAPEPLAN_ETC}/web.env"
  chown root:escapeplan "${ESCAPEPLAN_ETC}/web.env"
fi

echo "Configuration applied. Reloading services..."

systemctl daemon-reload

if [[ "$services_enable_wifi" == "true" || "$services_enable_wifi" == "1" ]]; then
  systemctl enable --now hostapd.service dnsmasq.service
else
  systemctl disable --now hostapd.service dnsmasq.service >/dev/null 2>&1 || true
fi

if [[ "$services_enable_api" == "true" || "$services_enable_api" == "1" ]]; then
  systemctl enable --now escapeplan-api.service
fi

if [[ "$services_enable_web" == "true" || "$services_enable_web" == "1" ]]; then
  systemctl enable --now escapeplan-web.service
fi

systemctl reload nginx.service || systemctl restart nginx.service

echo "EscapePlan platform configuration updated successfully."
