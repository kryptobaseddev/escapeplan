#!/usr/bin/env bash
set -euo pipefail

log() {
  echo "[escapeplan-platform-init] $1"
}

ESCAPEPLAN_ETC=/etc/escapeplan
TEMPLATE_DIR=${ESCAPEPLAN_ETC}/templates

install -d -m 0755 -o escapeplan -g escapeplan /var/lib/escapeplan
install -d -m 0755 -o escapeplan -g escapeplan /var/lib/escapeplan/assets
install -d -m 0755 -o escapeplan -g escapeplan /var/lib/escapeplan/hls
install -d -m 0750 -o escapeplan -g escapeplan /var/lib/escapeplan/backups
install -d -m 0755 -o escapeplan -g escapeplan /var/log/escapeplan
install -d -m 0755 -o escapeplan -g escapeplan /opt/escapeplan
install -d -m 0755 -o escapeplan -g escapeplan /etc/escapeplan
install -d -m 0755 -o escapeplan -g escapeplan /etc/escapeplan/certs

for template in "${TEMPLATE_DIR}"/*.tpl; do
  [ -e "$template" ] || continue
  basename=$(basename "$template" .tpl)
  target="${ESCAPEPLAN_ETC}/${basename}"
  if [ ! -f "$target" ]; then
    cp "$template" "$target"
    chmod 0640 "$target"
    chown escapeplan:escapeplan "$target"
    log "Seeded ${target} from template"
  fi
done

for env_file in api.env web.env ffmpeg.env; do
  target="${ESCAPEPLAN_ETC}/${env_file}"
  if [ ! -f "$target" ]; then
    touch "$target"
    chmod 0640 "$target"
    chown root:escapeplan "$target"
    log "Created ${target} placeholder"
  fi
done

exit 0
