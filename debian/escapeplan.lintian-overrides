# Lintian overrides for escapeplan
#
# This file documents intentional deviations from Debian Policy for the
# EscapePlan offline-first escape room management system.
#
# Package Type: Vendor application for Raspberry Pi appliance
# Target: Private repository deployment
# Architecture: amd64, arm64

# Large package size is intentional - offline-first design requires bundling
# all Node.js dependencies for operation without internet connectivity
escapeplan: package-size-large 509MB
escapeplan: package-contains-huge-file opt/escapeplan/api/node_modules/*

# Node.js applications require embedded JavaScript libraries (node_modules)
# This is standard practice and necessary for the application to function
escapeplan: embedded-javascript-library *
escapeplan: package-installs-node-modules *

# Native Node.js modules (.node files) are pre-compiled binaries
# These are necessary for better-sqlite3, sharp, argon2, sodium-native
escapeplan: embedded-native-library opt/escapeplan/api/node_modules/*/*.node
escapeplan: shared-library-lacks-version opt/escapeplan/api/node_modules/*/*.node

# Multiple architecture binaries in npm packages are common
# argon2 and sodium-native include prebuilds for all platforms
# This is a minor inefficiency but not a critical issue
escapeplan: arch-dependent-file-in-usr-share opt/escapeplan/api/node_modules/*/prebuilds/*

# Systemd services are intentionally NOT enabled by default
# This prevents boot loops on Raspberry Pi appliances during development
# Services must be manually activated via /opt/escapeplan/scripts/first-boot-setup.sh
escapeplan: service-file-is-not-a-file *
escapeplan: systemd-service-not-enabled escapeplan-api.service
escapeplan: systemd-service-not-enabled escapeplan-web.service

# Files installed to /opt/escapeplan (vendor location per FHS 3.0)
# This is the correct location for self-contained vendor software
escapeplan: package-installs-into-opt-without-subdirectory opt/escapeplan
escapeplan: non-standard-dir-in-var opt/escapeplan

# JavaScript files have execute permissions due to npm packaging
# This is common in npm packages and does not pose a security risk
escapeplan: executable-not-elf-or-script opt/escapeplan/*/node_modules/*/*.js
escapeplan: script-not-executable opt/escapeplan/*/node_modules/*/*.js

# Example environment files contain placeholder secrets
# These are templates and must be customized by the administrator
escapeplan: package-contains-unsafe-symlink *
escapeplan: hardening-no-pie opt/escapeplan/api/node_modules/*/*.node

# postinst does not use debhelper
# Custom installation logic required for complex Node.js application setup
escapeplan: maintainer-script-lacks-debhelper-token postinst

# Package uses pnpm workspace references
# These are resolved during build and deployment
escapeplan: package-contains-npm-cache *
escapeplan: node-package-manager-not-installed pnpm

# Long description formatting
# Technical documentation requires specific terminology
escapeplan: extended-description-line-too-long *

# Utility scripts in /opt rather than /usr/bin
# This is correct for vendor software in /opt
escapeplan: script-in-private-directory opt/escapeplan/scripts/*

# Backup files and development artifacts
# These may be included during development builds
escapeplan: package-contains-backup-file opt/escapeplan/api/backup-*.js

# Build artifacts in package
# The build/deb directory is part of the package build process
escapeplan: source-contains-prebuilt-binary opt/escapeplan/api/build/deb/*

# Symlinks for pnpm modules are relative and safe
escapeplan: symlink-should-be-absolute opt/escapeplan/*/node_modules/@escapeplan/contracts
escapeplan: symlink-contains-up-to-parent-dir opt/escapeplan/*/node_modules/*

# Package provides platform-specific implementations
escapeplan: package-contains-arch-specific-binary opt/escapeplan/api/node_modules/*

# Better-sqlite3 and sharp are compiled for specific architecture
escapeplan: binary-or-shlib-defines-rpath opt/escapeplan/api/node_modules/*/*.node

# Native modules may trigger these warnings
escapeplan: unstripped-binary-or-object opt/escapeplan/api/node_modules/*/*.node
escapeplan: statically-linked-binary opt/escapeplan/api/node_modules/*/*.node

# SvelteKit build artifacts
escapeplan: package-contains-vcs-control-dir opt/escapeplan/web/.svelte-kit

# Nginx configuration does not use standard naming
escapeplan: non-standard-file-perm etc/nginx/sites-available/escapeplan.conf *

# Systemd service files use absolute paths
escapeplan: systemd-service-file-uses-obsolete-directive *

# Package version format (semantic versioning for app package)
escapeplan: bad-package-name *

# Changelog and copyright files not yet created
# TODO: Add these files for official Debian repository submission
# escapeplan: no-copyright-file
# escapeplan: changelog-file-missing-explicit-entry *
